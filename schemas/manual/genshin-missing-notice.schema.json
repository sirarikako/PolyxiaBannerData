{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "原神无帖子人工公告来源（按逻辑身份自动派生字段）",
  "description": "【尚未接入发布脚本的数据契约】完全缺少真实官方文章时，用 noticeType、identity、data、evidence 保存人工核对资料，不伪造 postId。人工只在 identity 填写版本/期数/卡池类型/特殊类型；程序从 identity 自动生成稳定 sourceKey、文件名，并在转换为解析候选时填入版本、期数、poolType、variant；这些派生字段不允许手工在 JSON 重复填写。祈愿预告若只包含集录/溯光等特殊池，可不写 up；常规池仍须核实并提供五星 UP 汇总。跨公告类型、整期池构成及发布安全性须在候选整合阶段检查。本 Schema 的 missing 读取链当前尚未接入正式脚本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "noticeType",
    "identity",
    "data",
    "evidence"
  ],
  "properties": {
    "format": {
      "const": "genshin-missing-notice-v1",
      "description": "【必填】无官方帖子来源人工数据的独立格式标记。不能写 genshin-notice-manual-v1，也不能提供伪造的 postId。"
    },
    "noticeType": {
      "enum": [
        "version_update",
        "wish_preview",
        "wish_notice"
      ],
      "description": "【必填】人工补齐的是版本更新、祈愿预告还是单池祈愿公告。"
    },
    "identity": {
      "description": "【必填，唯一身份输入】版本更新填 version；祈愿预告填 version+phase；单池祈愿公告填 version+phase+poolType，集录/溯光追加 variant。程序据此生成稳定 sourceKey、文件名和候选数据中的身份字段，无需人工重复输入。",
      "oneOf": [
        {
          "$ref": "#/$defs/versionIdentity"
        },
        {
          "$ref": "#/$defs/previewIdentity"
        },
        {
          "$ref": "#/$defs/noticeIdentity"
        }
      ]
    },
    "data": {
      "type": "object",
      "description": "【必填】只填写该公告特有的业务内容，不重复填写 identity 已提供的 version、phase、poolType、variant，也不添加机器生成的 sourceKey。正常池预告的五星 UP 汇总按实际整期核对；只有特殊池时可省略 up；正式候选整合时仍要验证引用的一致性。"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "【必填】人工核对依据简述、来源与判断结论；不能声称实际未确认的官方公告已存在。"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "来源或核对材料的文字说明。"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "description": "【可选】可核实的 HTTPS 证据链接；无可靠链接时省略，不得拼造公告 URL。"
              },
              "kind": {
                "enum": [
                  "official",
                  "cross_check",
                  "manual"
                ],
                "description": "证据类别，仅用于审计，不赋予自动解析可信度。"
              }
            }
          },
          "description": "【可选】附加人工核对依据。不存在官方帖子 URL 时可只填写 summary。"
        }
      },
      "description": "来源审查记录；不充当机器伪造的 postId、OCR 信息或官方采集成功状态。"
    }
  },
  "$defs": {
    "versionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "仅按版本识别一次版本更新公告。"
        }
      }
    },
    "previewIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "phase"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "noticeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "phase",
        "poolType"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "poolType": {
          "enum": [
            "character_event",
            "character_event_2",
            "weapon_event",
            "chronicled"
          ]
        },
        "variant": {
          "enum": [
            "chronicled",
            "special_recollection"
          ],
          "description": "【条件必填】集录/溯光祈愿的类型，用于避免同版本同一期的身份混淆。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "poolType": {
                "const": "chronicled"
              }
            },
            "required": [
              "poolType"
            ]
          },
          "then": {
            "required": [
              "variant"
            ]
          },
          "else": {
            "not": {
              "required": [
                "variant"
              ]
            }
          }
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "element": {
              "type": "string"
            },
            "weaponType": {
              "type": "string"
            },
            "rarity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "limited": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "acquisition": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "nameList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "description": "一份完整 UP/可选名单，可以用名称字符串简写。自动比对时忽略名单顺序，[] 是明确没有，省略表示未提供。"
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fiveStarCharacters": {
          "$ref": "#/$defs/nameList"
        },
        "fourStarCharacters": {
          "$ref": "#/$defs/nameList"
        },
        "fiveStarWeapons": {
          "$ref": "#/$defs/nameList"
        },
        "fourStarWeapons": {
          "$ref": "#/$defs/nameList"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endAt"
      ],
      "properties": {
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\+08:00$",
          "description": "【条件必填】非第一期必须有真实开池时刻；第一期“版本更新后”可使用 startCondition。"
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\+08:00$",
          "description": "【必填】公告原始结束分钟，例如 14:59:00+08:00；生成 v1 时转换为独占结束边界（+1 分钟）。"
        },
        "startCondition": {
          "const": "after_version_update",
          "description": "【第一期可用】仅第一期写“版本更新后”时使用，开始时间取版本更新维护开始时刻。"
        },
        "startRaw": {
          "type": "string",
          "description": "【可选】官方或人工核实的开放时间原文。"
        },
        "endRaw": {
          "type": "string",
          "description": "【可选】官方或人工核实的结束时间原文。"
        }
      },
      "anyOf": [
        {
          "required": [
            "startAt"
          ]
        },
        {
          "required": [
            "startCondition"
          ]
        }
      ]
    },
    "updateData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintenance"
      ],
      "properties": {
        "versionName": {
          "type": "string",
          "minLength": 1,
          "description": "【可选】版本中文名称。"
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startAt"
          ],
          "properties": {
            "startAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\+08:00$",
              "description": "【最低必填】版本维护开始时刻；第一期更新后卡池的开池时间取此值。"
            },
            "estimatedEndAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\+08:00$"
            },
            "estimatedDurationHours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "newCharacters": {
          "$ref": "#/$defs/nameList"
        },
        "newWeapons": {
          "$ref": "#/$defs/nameList"
        }
      },
      "description": "版本更新：维护开始时间必需；版本号仅在 identity.version 填写，由后续处理程序自动填入候选的 version。新角色、新武器、版本名称可选。"
    },
    "previewData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endAt"
          ],
          "properties": {
            "startAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\+08:00$"
            },
            "endAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\+08:00$",
              "description": "【最低必填】用于与单池公告结束分钟进行精确匹配。"
            },
            "startCondition": {
              "const": "after_version_update"
            },
            "startRaw": {
              "type": "string"
            },
            "endRaw": {
              "type": "string"
            }
          }
        },
        "up": {
          "$ref": "#/$defs/groups",
          "description": "【条件必填】预告有常规角色/武器 UP 池时，需提供对应的整期五星 UP 名单，以便与单池正式公告核对；如果这一期仅有集录/溯光等特殊池，没有常规 UP 汇总，则允许完全省略 up。Schema 无法仅根据预告本身判断整期是否有常规池，是否足够用于发布由候选整合阶段结合该期其他池子检查。"
        },
        "additionalWishes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "noticeType"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "chronicled",
                  "recollection"
                ]
              },
              "noticeType": {
                "enum": [
                  "集录祈愿",
                  "溯光祈愿"
                ]
              }
            }
          }
        }
      },
      "description": "祈愿预告：版本号与期数从 identity 派生。data 只需公告结束分钟，以及有常规角色/武器池时的整期五星 UP 汇总；仅存在集录/溯光等特殊池时，up 可省略。Schema 不知道其他单池是否存在，常规池场景由后续整合阶段强制检查。"
    },
    "noticeData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bannerName",
        "time"
      ],
      "properties": {
        "bannerName": {
          "type": "string",
          "minLength": 1,
          "description": "【最低必填】卡池正式中文名称。"
        },
        "officialWishType": {
          "type": "string",
          "minLength": 1,
          "description": "【可选】公告原始祈愿类型说明。"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "up": {
          "$ref": "#/$defs/groups"
        },
        "selectable": {
          "$ref": "#/$defs/groups"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limitedNotInStandard": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "characterEventPityShared": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "characterTrial": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "description": "单池祈愿公告：poolType、variant、版本、期数只填 identity，转换候选时自动继承。data 只填卡池名称、时间及按 identity.poolType 要求的完整 UP 或 selectable 名单。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "version_update"
          }
        },
        "required": [
          "noticeType"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/versionIdentity"
          },
          "data": {
            "$ref": "#/$defs/updateData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "wish_preview"
          }
        },
        "required": [
          "noticeType"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/previewIdentity"
          },
          "data": {
            "$ref": "#/$defs/previewData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "wish_notice"
          }
        },
        "required": [
          "noticeType"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/noticeIdentity"
          },
          "data": {
            "$ref": "#/$defs/noticeData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "wish_notice"
          },
          "identity": {
            "properties": {
              "phase": {
                "minimum": 2
              }
            }
          }
        },
        "required": [
          "noticeType",
          "identity"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "time": {
                "required": [
                  "startAt"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "wish_notice"
          },
          "identity": {
            "properties": {
              "poolType": {
                "enum": [
                  "character_event",
                  "character_event_2"
                ]
              }
            },
            "required": [
              "poolType"
            ]
          }
        },
        "required": [
          "noticeType",
          "identity"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "up"
            ],
            "properties": {
              "up": {
                "allOf": [
                  {
                    "$ref": "#/$defs/groups"
                  },
                  {
                    "allOf": [
                      {
                        "properties": {
                          "fiveStarCharacters": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 1,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        },
                        "required": [
                          "fiveStarCharacters"
                        ]
                      },
                      {
                        "properties": {
                          "fourStarCharacters": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        },
                        "required": [
                          "fourStarCharacters"
                        ]
                      },
                      {
                        "properties": {
                          "fiveStarWeapons": {
                            "type": "array",
                            "maxItems": 0,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        }
                      },
                      {
                        "properties": {
                          "fourStarWeapons": {
                            "type": "array",
                            "maxItems": 0,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "wish_notice"
          },
          "identity": {
            "properties": {
              "poolType": {
                "const": "weapon_event"
              }
            },
            "required": [
              "poolType"
            ]
          }
        },
        "required": [
          "noticeType",
          "identity"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "up"
            ],
            "properties": {
              "up": {
                "allOf": [
                  {
                    "$ref": "#/$defs/groups"
                  },
                  {
                    "allOf": [
                      {
                        "properties": {
                          "fiveStarWeapons": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        },
                        "required": [
                          "fiveStarWeapons"
                        ]
                      },
                      {
                        "properties": {
                          "fourStarWeapons": {
                            "type": "array",
                            "minItems": 5,
                            "maxItems": 5,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        },
                        "required": [
                          "fourStarWeapons"
                        ]
                      },
                      {
                        "properties": {
                          "fiveStarCharacters": {
                            "type": "array",
                            "maxItems": 0,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        }
                      },
                      {
                        "properties": {
                          "fourStarCharacters": {
                            "type": "array",
                            "maxItems": 0,
                            "items": {
                              "$ref": "#/$defs/name"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "noticeType": {
            "const": "wish_notice"
          },
          "identity": {
            "properties": {
              "poolType": {
                "const": "chronicled"
              }
            },
            "required": [
              "poolType"
            ]
          }
        },
        "required": [
          "noticeType",
          "identity"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "selectable"
            ],
            "properties": {
              "selectable": {
                "allOf": [
                  {
                    "$ref": "#/$defs/groups"
                  },
                  {
                    "required": [
                      "fiveStarCharacters",
                      "fiveStarWeapons"
                    ],
                    "properties": {
                      "fiveStarCharacters": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      },
                      "fiveStarWeapons": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      }
                    }
                  }
                ]
              },
              "up": {
                "allOf": [
                  {
                    "$ref": "#/$defs/groups"
                  },
                  {
                    "properties": {
                      "fiveStarCharacters": {
                        "type": "array",
                        "maxItems": 0,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "fourStarCharacters": {
                        "type": "array",
                        "maxItems": 0,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "fiveStarWeapons": {
                        "type": "array",
                        "maxItems": 0,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "fourStarWeapons": {
                        "type": "array",
                        "maxItems": 0,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
