{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "原神按版本 v1 人工修正",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "game",
    "locale",
    "version",
    "upcoming",
    "existing"
  ],
  "properties": {
    "format": {
      "const": "genshin-v1-overrides-v2"
    },
    "game": {
      "const": "genshin"
    },
    "locale": {
      "const": "zh-CN"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "upcoming": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/upcoming"
      }
    },
    "existing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/existing"
      }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "poolType"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "poolType": {
          "enum": [
            "character_event",
            "character_event_2",
            "weapon_event",
            "chronicled"
          ]
        },
        "variant": {
          "enum": [
            "chronicled",
            "special_recollection"
          ]
        },
        "bannerName": {
          "type": "string",
          "minLength": 1
        },
        "postId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "names": {
          "$ref": "../public/v1/banner-data.schema.json#/$defs/names"
        },
        "gachaTypes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw": {
              "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/gachaTypes/properties/raw"
            },
            "uigf": {
              "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/gachaTypes/properties/uigf"
            }
          }
        },
        "featured": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fiveStar": {
              "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/featured/properties/fiveStar"
            },
            "fourStar": {
              "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/featured/properties/fourStar"
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "server"
            ],
            "additionalProperties": false,
            "properties": {
              "server": {
                "$ref": "../public/v1/banner-data.schema.json#/$defs/region/properties/server"
              },
              "startAt": {
                "$ref": "../public/v1/banner-data.schema.json#/$defs/region/properties/startAt"
              },
              "endAt": {
                "$ref": "../public/v1/banner-data.schema.json#/$defs/region/properties/endAt"
              }
            }
          }
        },
        "sources": {
          "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/sources"
        },
        "images": {
          "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/images"
        },
        "fatePointLimit": {
          "$ref": "../public/v1/banner-data.schema.json#/$defs/banner/properties/fatePointLimit"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "itemIds"
          ]
        },
        {
          "required": [
            "addSources"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^gi-[0-9]{6}$"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "completedAt": {
          "type": "string",
          "minLength": 1
        },
        "appliedId": {
          "type": "string",
          "pattern": "^gi-[0-9]{6}$"
        },
        "set": {
          "$ref": "#/$defs/set"
        },
        "itemIds": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "addSources": {
          "type": "array",
          "items": {
            "$ref": "../public/v1/banner-data.schema.json#/$defs/source"
          }
        }
      }
    },
    "upcoming": {
      "allOf": [
        {
          "$ref": "#/$defs/patch"
        },
        {
          "required": [
            "match"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "existing": {
      "allOf": [
        {
          "$ref": "#/$defs/patch"
        },
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "match"
            ]
          }
        }
      ]
    }
  }
}
