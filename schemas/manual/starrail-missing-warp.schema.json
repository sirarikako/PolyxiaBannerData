{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "星铁缺失跃迁公告人工来源",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "identity",
    "data",
    "evidence"
  ],
  "properties": {
    "format": {
      "const": "starrail-missing-warp-v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "phase",
        "poolType",
        "bannerName"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "poolType": {
          "enum": [
            "character_event",
            "light_cone_event",
            "collab_character",
            "collab_light_cone"
          ]
        },
        "bannerName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featured",
        "time"
      ],
      "properties": {
        "featured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fiveStar",
            "fourStar"
          ],
          "properties": {
            "fiveStar": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fourStar": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startAt",
            "endAt"
          ],
          "properties": {
            "startAt": {
              "type": "string",
              "format": "date-time"
            },
            "endAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "startCondition": {
              "const": "after_version_update"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
