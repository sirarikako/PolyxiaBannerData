{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "星铁真实文章逐池人工补足",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "postId",
    "banners"
  ],
  "properties": {
    "format": {
      "const": "starrail-notice-manual-v1"
    },
    "postId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "note": {
      "type": "string"
    },
    "banners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "data"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "phase",
              "poolType",
              "bannerName"
            ],
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "phase": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "poolType": {
                "enum": [
                  "character_event",
                  "light_cone_event",
                  "collab_character",
                  "collab_light_cone"
                ]
              },
              "bannerName": {
                "type": "string",
                "minLength": 1
              },
              "fiveStarName": {
                "type": "string",
                "minLength": 1,
                "description": "同版本同一期同池种同名多池时的五星 UP 名称，用于唯一定位"
              }
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "featured": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "fiveStar": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "fourStar": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "time": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "startAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "startCondition": {
                    "enum": [
                      "after_version_update",
                      null
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
